function(pfng_declare_kernel)
    cmake_parse_arguments(ARG "" "ID;NAME;QUANTIZATION;REGISTER_FUNCTION"
                          "PLATFORMS" ${ARGN})
    foreach(required ID NAME QUANTIZATION REGISTER_FUNCTION)
        if(NOT ARG_${required})
            message(FATAL_ERROR "pfng_declare_kernel requires ${required}")
        endif()
    endforeach()
    if(NOT ARG_PLATFORMS)
        message(FATAL_ERROR "Kernel '${ARG_ID}' must declare PLATFORMS")
    endif()

    get_property(ids GLOBAL PROPERTY PFNG_KERNEL_IDS)
    if(ARG_ID IN_LIST ids)
        message(FATAL_ERROR "Duplicate kernel ID '${ARG_ID}'")
    endif()
    set_property(GLOBAL APPEND PROPERTY PFNG_KERNEL_IDS "${ARG_ID}")

    if(PFNG_TARGET_PLATFORM IN_LIST ARG_PLATFORMS)
        set(PFNG_CURRENT_KERNEL_ENABLED TRUE PARENT_SCOPE)
        set_property(GLOBAL APPEND PROPERTY PFNG_KERNEL_REGISTRATION_FUNCTIONS
                     "${ARG_REGISTER_FUNCTION}")
    else()
        set(PFNG_CURRENT_KERNEL_ENABLED FALSE PARENT_SCOPE)
    endif()
endfunction()

function(pfng_generate_builtin_kernels output)
    get_property(functions GLOBAL PROPERTY PFNG_KERNEL_REGISTRATION_FUNCTIONS)
    set(content "#include \"adapter_common.h\"\n\nnamespace pfng::bench::adapters {\nvoid register_builtin_kernels() {\n")
    foreach(function IN LISTS functions)
        string(APPEND content "    ${function}();\n")
    endforeach()
    string(APPEND content "}\n} // namespace pfng::bench::adapters\n")
    file(GENERATE OUTPUT "${output}" CONTENT "${content}")
endfunction()